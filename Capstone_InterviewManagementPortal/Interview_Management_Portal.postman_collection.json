          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "{{auth_password}}",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "{{auth_username}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_password\": \"newSecurePass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
